<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Optional: Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Optional: Embed source files that are not tracked by the source control manager in the PDB -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Optional: Build symbol package (.snupkg) to distribute the PDB containing Source Link -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Nuget specs -->
    <PackageId>DnsProxy.Aws</PackageId>
    <Authors>Björn Lundström</Authors>
    <Copyright>© 2019-2020 Björn Lundström</Copyright>
    <Title>BLun DNS Proxy</Title>
    <Description>A dns-proxy for Developers!</Description>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>dns</PackageTags>
    <PackageReleaseNotes>https://github.com/BLun78/DnsProxy/releases</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/BLun78/DnsProxy</PackageProjectUrl>
    <Company>BLun.de - Björn Lundström</Company>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/BLun78/DnsProxy.git</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.APIGateway" Version="3.7.300.68" />
    <PackageReference Include="AWSSDK.ApiGatewayV2" Version="3.7.300.66" />
    <PackageReference Include="AWSSDK.DocDB" Version="3.7.302.36" />
    <PackageReference Include="AWSSDK.EC2" Version="3.7.321.2" />
    <PackageReference Include="AWSSDK.ECS" Version="3.7.305.28" />
    <PackageReference Include="AWSSDK.EKS" Version="3.7.305.2" />
    <PackageReference Include="AWSSDK.ElastiCache" Version="3.7.302.3" />
    <PackageReference Include="AWSSDK.ElasticLoadBalancing" Version="3.7.300.66" />
    <PackageReference Include="AWSSDK.ElasticLoadBalancingV2" Version="3.7.302.22" />
    <PackageReference Include="AWSSDK.MQ" Version="3.7.300.66" />
    <PackageReference Include="AWSSDK.RDS" Version="3.7.310.7" />
    <PackageReference Include="AWSSDK.Redshift" Version="3.7.304.20" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.300.67" />
    <PackageReference Include="AWSSDK.SSO" Version="3.7.300.66" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="3.7.301.61" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />

    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\3thParty\ARSoft.Tools.Net\ARSoft.Tools.Net.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\Common\DnsProxy.Common\DnsProxy.Common.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\Common\DnsProxy.Plugin\DnsProxy.Plugin.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PluginHostTf Include="net5.0" />
  </ItemGroup>

  <Target Name="PluginCopy" AfterTargets="Build">

    <ItemGroup>
      <ServerOutput Include="$(OutputPath)/*.*" />
    </ItemGroup>

    <!-- Deploy all required server outputs -->
    <Copy SourceFiles="@(ServerOutput)" DestinationFolder="../../DnsProxy.Console/$(BaseOutputPath)$(Configuration)/%(PluginHostTf.Identity)/Plugins/$(MSBuildProjectName)/" />
  </Target>
</Project>
